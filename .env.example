APP_NAME="نوته بوك"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_DATABASE=nootabooks
DB_USERNAME=root
DB_PASSWORD=


SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@maktabati.test"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_OTP_RECIPIENT=

# Must be a reCAPTCHA v3 key pair (registered as type "v3" in the Google
# admin console) — v2 keys are not compatible with this app's v3 flow.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Analytics measurement ID (gtag.js) — leave blank to disable.
# Never fires in local env regardless, even if set.
GOOGLE_ANALYTICS_ID=
